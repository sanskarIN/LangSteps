{
  "name": "langsteps",
  "version": "1.2.0",
  "description": "Open-source programming lessons for HTML, CSS, JavaScript, React, Python, TypeScript, Rust, Go, SQL and C#, with an optional ASP.NET Core backend.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run validate:curriculum && npm test && npm run typecheck && npm run typecheck:curriculum && npm run typecheck:sw && npm run typecheck:online && npm run build && npm run build:curriculum && npm run build:sw && npm run build:online",
    "build:curriculum": "tsc --project tsconfig.curriculum.json",
    "typecheck:curriculum": "tsc --project tsconfig.curriculum.json --noEmit",
    "validate:curriculum": "node scripts/validate-curricula.cjs",
    "test:browser": "playwright test",
    "typecheck:sw": "tsc --project tsconfig.sw.json --noEmit",
    "build:sw": "tsc --project tsconfig.sw.json && node scripts/copy-worker.cjs",
    "typecheck:online": "tsc --project tsconfig.online.json --noEmit",
    "build:online": "tsc --project tsconfig.online.json && node scripts/copy-online.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanskarIN/LangSteps.git"
  },
  "bugs": {
    "url": "https://github.com/sanskarIN/LangSteps/issues"
  },
  "homepage": "https://sanskarin.github.io/LangSteps",
  "author": "Sanskar <sanskarin@outlook.in> (https://sanskarin.github.io/about)",
  "keywords": [
    "python",
    "typescript",
    "javascript",
    "aspnetcore",
    "csharp",
    "web-development",
    "education",
    "quiz",
    "interactive-learning",
    "langsteps"
  ],
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.10.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "typescript": "^7.0.2",
    "@playwright/test": "^1.56.0"
  }
}
