{
  "name": "langsteps",
  "version": "1.1.0",
  "description": "Open-source programming lessons for HTML, CSS, JavaScript, React, Python, TypeScript, Rust, Go, SQL and C#, with an optional ASP.NET Core backend.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run test && npm run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanskarIN/LangSteps.git"
  },
  "bugs": {
    "url": "https://github.com/sanskarIN/LangSteps/issues"
  },
  "homepage": "https://sanskarin.github.io/LangSteps",
  "author": "Sanskar <sanskarin@outlook.in> (https://sanskarin.github.io/about)",
  "keywords": [
    "python",
    "typescript",
    "javascript",
    "aspnetcore",
    "csharp",
    "web-development",
    "education",
    "quiz",
    "interactive-learning",
    "langsteps"
  ],
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "^10.10.0",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "typescript": "^7.0.2"
  }
}
